","url":null,"note":"The cell used here.","tags":["lattice"]},{"citation":"Morse, J.W., Wang, Q., Tsio, M.Y. (1997). Influences of temperature and Mg:Ca ratio on CaCO<sub>3</sub> precipitates from seawater. <i>Geology</i> 25, 85–87.","doi":"10.1130/0091-7613(1997)025<0085:IOTAMC>2.3.CO;2","url":null,"note":"Temperature and Mg/Ca control on aragonite versus calcite.","tags":["morphology"]},{"citation":"Folk, R.L. (1974). The natural history of crystalline calcium carbonate; effect of magnesium content and salinity. <i>Journal of Sedimentary Petrology</i> 44, 40–53.","doi":"10.1306/74D72973-2B21-11D7-8648000102C1865D","url":null,"note":"Classic model: Mg poisoning gives fibrous calcite elongated along c, versus equant meteoric calcite.","tags":["morphology"]},{"citation":"Given, R.K., Wilkinson, B.H. (1985). Kinetic control of morphology, composition, and mineralogy of abiotic sedimentary carbonates. <i>Journal of Sedimentary Petrology</i> 55, 109–119.","doi":"10.1306/212F862A-2B24-11D7-8648000102C1865D","url":null,"note":"Equant versus acicular habit as a record of reactant supply rate.","tags":["morphology"]}],"cells":[{"id":"Tc","row":0,"col":0,"label":"Tc","sub":"","title":"Tc: thick tabular on (001) · terminated by c{001} flat","description":"thick tabular on (001); terminated by c{001} flat.","default":false,"params":{"face_distances":{"110":1.0,"010":1.0,"001":0.3,"011":null,"021":null,"111":null},"cap_translation":0.0,"scale":0.78338819,"planes":{"110":0.78338819,"010":0.78338819,"001":0.23501646}},"fractions":{"110":0.2548,"010":0.1202,"001":0.625},"metrics":{"volume":1.0,"surface_area":6.80803,"rsv":0.44066,"sphericity":0.71033,"aspect":0.2547},"geometry":{"vertices":[[-0.43507,-0.78339,-0.23502],[-0.43507,-0.78339,0.23502],[0.92282,0.0,-0.23502],[0.43507,-0.78339,-0.23502],[0.92282,0.0,0.23502],[0.43507,-0.78339,0.23502],[-0.92282,0.0,-0.23502],[-0.92282,0.0,0.23502],[0.43507,0.78339,0.23502],[-0.43507,0.78339,0.23502],[0.43507,0.78339,-0.23502],[-0.43507,0