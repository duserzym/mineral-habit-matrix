nk between morphology and structure.","tags":["lattice","morphology"]},{"citation":"Armbruster, T., Gnos, E. (2000). P4/n and P4nc long-range ordering in low-temperature vesuvianites. <i>American Mineralogist</i> 85, 563–569.","doi":"10.2138/am-2000-0418","url":null,"note":"Symmetry lowering relative to P4/nnc.","tags":["crystallography"]},{"citation":"Tanaka, T., Akizuki, M., Kudoh, Y. (2002). Optical properties and crystal structure of triclinic growth sectors in vesuvianite. <i>Mineralogical Magazine</i> 66, 261–274.","doi":"10.1180/0026461026620027","url":null,"note":"Ordering that depends on the growth sector, i.e. on the face.","tags":["morphology"]}],"cells":[{"id":"P0p","row":0,"col":1,"label":"P0p","sub":"","title":"P0p: no prism (low dipyramid) · {001} + {101} termination","description":"no prism (low dipyramid); {001} + {101} termination.","default":false,"params":{"face_distances":{"100":null,"110":null,"001":0.8,"101":1.0,"301":null},"cap_translation":0.0,"scale":0.48565807,"planes":{"001":0.38852645,"101":0.48565807}},"fractions":{"001":0.1076,"101":0.8924},"metrics":{"volume":1.0,"surface_area":6.31305,"rsv":0.47521,"sphericity":0.76603,"aspect":0.3418},"geometry":{"vertices":[[-0.29141,-0.29141,-0.38853],[-0.80377,-0.80377,0.0],[0.29141,-0.29141,-0.38853],[0.80377,-0.80377,-0.0],[0.29141,0.29141,0.38853],[-0.29141,0.29141,0.38853],[0.29141,-0.29141,0.38853],[-0.29141,-0.29141,0.38853],[0.29141,0.29141,-0.38853],[-0.29141,0.29141,-0.38853],[0.80377,0.80377,0.0],[-0.80377,0.80377,0.0]],"faces":[{"form":"001","hkl":[0,0,1],"loop":[7,6,4,5]},{"form":"001","hkl":[0,0,-1],"loop":[2,0,9,8]},{"form":"101","hkl":[1,0,1],"loop":[4,6,3,10]},{"form":"101","hkl":[0,1,1],"loop":[11,5,4,10]},{"form":"101","hkl":[-1,0,1],"loop":[11,1,7,5]},{"form":"101","hkl":[-1,0,-1],"loop":[11,9,0,1]},{"form":"101","hkl":[0,-1,-1],"loop":[1,0,2,3]},{"form":"101","hkl":[0,-1,1],"loop":[6,7,1,3]},{"form":"101","hkl":[1,0,-1],"loop":[3,2,8,10]},{"form":"101","hkl":[0,1,-1],"loop":[1