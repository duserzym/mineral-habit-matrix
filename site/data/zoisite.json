gy"]},{"citation":"Franz, G., Liebscher, A. (2004). Physical and chemical properties of the epidote minerals – an introduction. <i>Reviews in Mineralogy and Geochemistry</i> 56, 1–81.","doi":"10.2138/gsrmg.56.1.1","url":null,"note":"Zoisite crystallography and settings.","tags":["review"]},{"citation":"Smith, J.V., Pluth, J.J., Richardson, J.W. Jr., Kvick, Å. (1987). Neutron diffraction study of zoisite at 15 K and X-ray study at room temperature. <i>Zeitschrift für Kristallographie</i> 179, 305–321.","doi":"10.1524/zkri.1987.179.14.305","url":null,"note":"Structure and the cell used here.","tags":["lattice"]},{"citation":"Alvaro, M., Angel, R.J., Cámara, F. (2012). High-pressure behavior of zoisite. <i>American Mineralogist</i> 97, 1165–1176.","doi":"10.2138/am.2012.4014","url":null,"note":"Modern Pnma structure work.","tags":["lattice"]}],"cells":[{"id":"1s","row":0,"col":0,"label":"1s","sub":"","title":"1s: short-prismatic along b, 1.5:1 · squarish (100)+(001) section (tanzanite)","description":"short-prismatic along b, 1.5:1; squarish (100)+(001) section (tanzanite).","default":false,"params":{"face_distances":{"100":0.95,"001":0.95,"101":1.1,"201":null,"011":1.0,"111":1.05},"cap_translation":0.632004,"scale":0.46466315,"planes":{"100":0.44142999,"001":0.44142999,"101":0.51112947,"011":0.72166799,"111":0.73407549}},"fractions":{"100":0.3013,"001":0.2143,"101":0.17,"011":0.1091,"111":0.2053},"metrics":{"volume":1.0,"surface_area":5.51559,"rsv":0.54391,"sphericity":0.87678,"aspect":1.5},"geometry":{"vertices":[[-0.44143,-0.54324,-0.32778],[-0.25801,-0.54324,-0.44143],[-0.44143,-0.72446,0.0],[-0.44143,-0.54324,0.32778],[-0.25801,-0.54324,0.44143],[-0.14906,-0.58057,0.44143],[0.44143,-0.54324,-0.32778],[0.25801,-0.54324,-0.44143],[0.44143,-0.72446,0.0],[0.44143,-0.54324,0.32778],[0.14906,-0.58057,0.44143],[0.25801,-0.54324,0.44143],[-0.14906,-0.58057,-0.44143],[0.14906,-0.58057,-0.44143],[-0.14906,-0.82462,0.0],[0.14906,-0.82462,0.0],[0.44143,0.54324,0.32778],[0.258